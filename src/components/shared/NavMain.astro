    line-height: 1.6;
    color: #999;
  }
  .mnav__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
    line-height: 24px;
  }
  .mnav__card-cta:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* ---------- Hamburger + drawer (tablet / phone) ---------- */
  .mnav__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
  }
  .mnav__burger span {
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--mnav-ink);
    transition: all 0.2s ease;
  }
  .mnav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: rotate(45deg) translateY(7px);
  }
  .mnav__burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .mnav__burger[aria-expanded='true'] span:nth-child(3) {
    transform: rotate(-45deg) translateY(-7px);
  }

  .mnav__drawer {
    position: fixed;
    top: 92px;
    left: 2.5%;
    right: 2.5%;
    bottom: 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px 20px 32px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 24px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.1);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    pointer-events: auto;
    animation: mnav-drawer-in 0.2s ease;
  }
  .mnav__drawer[hidden] {
    display: none;
  }
  .mnav__m-toggle,
  .mnav__m-link {
    width: 100%;
    padding: 14px 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 29px;
    color: var(--mnav-ink);
    text-align: left;
  }
  .mnav__m-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mnav__m-link {
    display: block;
  }
  .mnav__m-entities {
    padding: 0 0 8px 8px;
  }
  .mnav__m-entities[hidden] {
    display: none;
  }
  .mnav__m-entity {
    padding: 12px 0;
  }
  .mnav__m-entity-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--mnav-ink);
    line-height: 25px;
  }
  .mnav__m-entity-tagline {
    margin-top: 1px;
    font-size: 12px;
    line-height: 21px;
    color: #999;
  }
  .mnav__m-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: 20px;
    padding: 14px;
    border-radius: 100px;
    background: var(--mnav-green);
    box-shadow: 0 4px 14px rgba(34, 197, 94, 0.35);
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    line-height: 27px;
  }

  @keyframes mnav-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes mnav-mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @keyframes mnav-drawer-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  /* ---------- Breakpoints ---------- */
  @media (max-width: 1199.98px) {
    .mnav__center,
    .mnav__right {
      display: none;
    }
    .mnav__burger {
      display: flex;
    }
  }
  @media (min-width: 1200px) {
    .mnav__drawer {
      display: none;
    }
  }
  /* Framer places the navbar's 92px spacer at the end of the phone layout, so the hero starts at the top. */
  @media (max-width: 809.98px) {
    .mnav-spacer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav *,
    .mnav {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mnav]');

  if (root) {
    const backdrop = root.querySelector<HTMLElement>('[data-mnav-backdrop]')!;
    const ecoBtn = root.querySelector<HTMLButtonElement>('[data-mnav-eco]')!;
    const mega = root.querySelector<HTMLElement>('[data-mnav-mega]')!;
    const burger = root.querySelector<HTMLButtonElement>('[data-mnav-burger]')!;
    const drawer = root.querySelector<HTMLElement>('[data-mnav-drawer]')!;
    const mEcoBtn = root.querySelector<HTMLButtonElement>('[data-mnav-m-eco]')!;
    const mEcoList = root.querySelector<HTMLElement>('#mnav-m-eco')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-mnav-cta]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // ---- Count-up stat (ease-out cubic, like the Framer component) ----
    let rafs: number[] = [];
    const runStat = (panel: Element) => {
      rafs.forEach(cancelAnimationFrame);
      rafs = [];
      const num = panel.querySelector<HTMLElement>('[data-count]');
      const bar = panel.querySelector<HTMLElement>('[data-bar]');
      if (!num || !bar) return;
      const target = Number(num.dataset.count);
      const decimal = target % 1 !== 0;
      const fmt = (v: number) => (decimal ? v.toFixed(1) : String(Math.floor(v)));
      if (reduceMotion.matches) {
        num.textContent = fmt(target);
        bar.style.width = '65%';
        return;
      }
      num.textContent = fmt(0);
      bar.style.width = '0%';
      const animate = (duration: number, update: (eased: number) => void) => {
        let start: number | null = null;
        const step = (t: number) => {
          start ??= t;
          const p = Math.min((t - start) / duration, 1);
          update(1 - Math.pow(1 - p, 3));
          if (p < 1) rafs.push(requestAnimationFrame(step));
        };
        rafs.push(requestAnimationFrame(step));
      };
      window.setTimeout(() => {
        animate(1200, (e) => (num.textContent = fmt(decimal ? Math.round(e * target * 10) / 10 : e * target)));
        animate(1400, (e) => (bar.style.width = `${Math.floor(e * 100) * 0.65}%`));
      }, 70);
    };

    const setEntity = (id: string) => {
      root.querySelectorAll<HTMLElement>('[data-entity]').forEach((el) => {
        el.classList.toggle('is-active', el.dataset.entity === id);
      });
      root.querySelectorAll<HTMLElement>('[data-entity-panel]').forEach((el) => {
        const on = el.dataset.entityPanel === id;
        const was = el.classList.contains('is-active');
        el.classList.toggle('is-active', on);
        if (on && !was) runStat(el);
      });
    };

    // ---- Open / close ----
    const syncBackdrop = () => {
      backdrop.hidden = mega.hidden && drawer.hidden;
    };
    const setMega = (open: boolean) => {
      mega.hidden = !open;
      ecoBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        const active = root.querySelector('[data-entity-panel].is-active');
        if (active) runStat(active);
      }
      syncBackdrop();
    };
    const setDrawer = (open: boolean) => {
      drawer.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      syncBackdrop();
    };

    ecoBtn.addEventListener('click', () => {
      setDrawer(false);
      setMega(mega.hidden);
    });
    burger.addEventListener('click', () => {
      setMega(false);
      setDrawer(drawer.hidden);
    });
    backdrop.addEventListener('click', () => {
      setMega(false);
      setDrawer(false);
    });
    mEcoBtn.addEventListener('click', () => {
      const open = mEcoList.hidden;
      mEcoList.hidden = !open;
      mEcoBtn.setAttribute('aria-expanded', String(open));
    });

    root.querySelectorAll<HTMLElement>('[data-entity]').forEach((el) => {
      const activate = () => setEntity(el.dataset.entity!);
      el.addEventListener('mouseenter', activate);
      el.addEventListener('focus', activate);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!mega.hidden) {
        setMega(false);
        ecoBtn.focus();
      } else if (!drawer.hidden) {
        setDrawer(false);
        burger.focus();
      }
    });

    // Close the mega menu when keyboard focus leaves it and its toggle.
    mega.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !mega.contains(next) && next !== ecoBtn) setMega(false);
    });

    window.matchMedia('(min-width: 1200px)').addEventListener('change', () => {
      setMega(false);
      setDrawer(false);
    });

    // ---- "Get in touch" appears after scrolling 40px ----
    const onScroll = () => {
      const scrolled = window.scrollY > 40;
      root.classList.toggle('is-scrolled', scrolled);
      cta.tabIndex = scrolled ? 0 : -1;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
