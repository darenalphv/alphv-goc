  }
  .mnav__service {
    padding: 12px 0;
    border-bottom: 1px solid #f5f5f8;
  }
  .mnav__service-title {
    margin-bottom: 2px;
    font-size: 14px;
    font-weight: 600;
    color: var(--mnav-ink);
    line-height: 25px;
  }
  .mnav__service-desc {
    font-size: 12px;
    line-height: 1.5;
    color: #777;
  }

  .mnav__card-col {
    padding: 24px 24px 24px 0;
  }
  .mnav__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 14px;
  }
  .mnav__card-top {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding: 20px;
    background: var(--accent);
  }
  .mnav__stat {
    padding: 14px 18px;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  }
  .mnav__stat-badge {
    margin-bottom: 4px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #aaa;
    line-height: 16px;
  }
  .mnav__stat-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .mnav__stat-number {
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .mnav__stat-label {
    font-size: 13px;
    font-weight: 400;
    color: #666;
    line-height: 24px;
  }
  .mnav__stat-bar {
    height: 3px;
    margin-top: 10px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.07);
  }
  .mnav__stat-fill {
    width: 65%;
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
  }
  .mnav__card-bottom {
    padding: 20px;
    background: #0d0d1f;
  }
  .mnav__card-tag {
    margin-bottom: 8px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
