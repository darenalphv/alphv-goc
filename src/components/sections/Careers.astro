---
// Full-bleed black careers band.
import Icon from '../ui/Icon.astro';
---

<section class="section section--black" aria-labelledby="careers-title">
  <div class="wrap careers">
    <div class="head__title">
      <p class="label">06 _ Careers</p>
      <h2 class="h1" id="careers-title">Build at<br />the peak.</h2>
    </div>
    <div class="careers__copy">
      <p class="lead muted">
        ALPHV is built by a 100% Malaysian team of engineers, trainers, community builders and consultants. You work on
        real client systems from week one. ALPHV Recruit also lists open tech roles with partner companies across Kuala
        Lumpur and Selangor.
      </p>
      <div class="actions">
        <a class="btn btn--solid-white" href="https://recruit.alphv.com" target="_blank" rel="noopener">
          See open roles <Icon name="arrow-up-right" />
        </a>
        <a class="btn btn--inverse" href="mailto:hello@alphv.com?subject=Careers%20at%20ALPHV">Email the team</a>
      </div>
    </div>
  </div>
</section>

<style>
  .careers {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px 48px;
    align-items: end;
  }
  .careers__copy {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  @media (max-width: 960px) {
    .careers {
      grid-template-columns: 1fr;
    }
  }
</style>
