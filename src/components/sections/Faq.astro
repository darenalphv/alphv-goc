---
// FAQ as native disclosure rows, plus FAQPage structured data.
import Icon from '../ui/Icon.astro';
import { faqs } from '../../data/group';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<section class="section" aria-labelledby="faq-title">
  <div class="wrap faq">
    <div class="head__title faq__head">
      <p class="label accent">07 _ Questions</p>
      <h2 class="h1" id="faq-title">FAQ.</h2>
    </div>
    <div class="faq__list">
      {
        faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>
              <span class="h3">{f.q}</span>
              <Icon name="plus" size={20} class="faq__icon" />
            </summary>
            <p class="body muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 40px 48px;
  }
  .faq__list {
    border-top: var(--rule);
  }
  details {
    border-bottom: var(--hairline);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 24px;
    cursor: pointer;
    list-style: none;
    transition: color var(--dur) var(--ease);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--blue);
  }
  summary :global(.faq__icon) {
    flex: none;
    transition: transform var(--dur) var(--ease);
  }
  details[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }
  details p {
    padding-bottom: 24px;
  }
  @media (max-width: 960px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
