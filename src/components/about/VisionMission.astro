---
// About — vision as a full-width blue card, then the mission card with its four commitments in a row
// (two columns on tablet, stacked on phones).
import SectionHeading from './SectionHeading.astro';

const mission = [
  ['Building', 'production AI and software that runs inside the systems businesses already use.'],
  ['Training', 'professionals and teams through practitioner-led, HRDC-certified programs.'],
  ['Connecting', 'technology companies with the developers in the Developer Kaki community.'],
  ['Placing', 'engineers, specialists and leaders with the companies that need them.'],
];
---

<section class="vm about-slide" data-reveal style="--reveal-distance:170px" aria-label="Vision and mission">
  <div class="vm__grid">
    <article class="vm__card vm__card--vision">
      <p class="vm__label">01</p>
      <SectionHeading parts={['Our Vision']} />
      <p class="vm__text">
        To be Southeast Asia's most trusted technology partner, where every organisation can put AI to work, build
        the skills to run it, and find the people to grow it.
      </p>
    </article>

    <article class="vm__card">
      <p class="vm__label">02</p>
      <SectionHeading parts={['Our Mission']} />
      <p class="vm__text">
        To help organisations adopt technology that delivers measurable results, through four companies that work
        together. We do this by:
      </p>
      <ul class="vm__list">
        {
          mission.map(([verb, rest]) => (
            <li>
              <strong class="text-blue">{verb}</strong> {rest}
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>

<style>
  .vm {
    width: 90%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 80px 0;
  }

  .vm__grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .vm__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px;
    border: 1px solid var(--c-border);
    border-radius: 30px;
    background: var(--c-surface);
  }
  .vm__card--vision {
    border-color: transparent;
    background: var(--c-blue);
    color: var(--c-white);
  }
  .vm__card--vision :global(.section-heading),
  .vm__card--vision .vm__text {
    color: var(--c-white);
  }

  .vm__card :global(.section-heading) {
    font-size: 40px;
    text-align: left;
  }

  .vm__label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .vm__text {
    max-width: 860px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.7;
    color: var(--c-text);
  }

  .vm__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 4px;
  }
  .vm__list li {
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--c-white);
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-text);
  }
  .vm__list strong { font-weight: 700; }

  @media (max-width: 1199.98px) {
    .vm__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 809.98px) {
    .vm { width: auto; padding: 60px 20px; }
    .vm__card { padding: 28px 24px; border-radius: 24px; }
    .vm__card :global(.section-heading) { font-size: 30px; }
    .vm__text { font-size: 15px; }
    .vm__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
