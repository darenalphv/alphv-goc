---
// About — "Our Story": how the group grew out of the Developer Kaki community, beside a real photo
// from a DevRel workshop. Replaces the earlier tag pills, parallax 3D logo and stock video.
import { url } from '../../lib/paths';
import SplitText from './SplitText.astro';

const facts = [
  ['2019', 'Developer Kaki community founded'],
  ['2023', 'ALPHV Technologies Sdn Bhd incorporated'],
  ['2026', 'ALPHV Group Pte. Ltd. incorporated in Singapore'],
];
---

<section class="story" aria-labelledby="story-title">
  <div class="story__grid">
    <div class="story__copy">
      <h2 class="story__title" id="story-title" data-split style="--split-stagger:0.1s">
        <SplitText parts={['Our Story']} />
      </h2>
      <p class="story__text">
        ALPHV grew out of Developer Kaki, the community Daren Tan founded in 2019. It is now Malaysia's largest
        developer community, with more than 82,000 members.
      </p>
      <p class="story__text">
        From that community grew a group of companies that supports organisations at every stage of their technology
        journey. ALPHV Technologies designs and runs production AI and software. ALPHV Academy trains professionals
        through HRDC-certified programs. ALPHV DevRel connects technology companies with developers. ALPHV Recruit
        places technical talent and leaders.
      </p>
      <dl class="story__facts">
        {
          facts.map(([year, text]) => (
            <div>
              <dt>{year}</dt>
              <dd>{text}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <img
      class="story__photo"
      src={url('/images/about-devrel-workshop.jpg')}
      alt="A full room of developers at an ALPHV DevRel workshop"
      width="1600"
      height="1066"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .story {
    width: 90%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 80px 0;
  }

  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    align-items: center;
  }

  .story__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .story__title {
    font-family: var(--font-sans);
    font-size: 50px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--c-blue);
  }

  .story__text {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.8;
    color: var(--c-text);
  }

  .story__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 10px 0 0;
  }
  .story__facts div {
    padding: 16px 18px;
    border: 1px solid var(--c-border);
    border-radius: 16px;
    background: var(--c-surface);
  }
  .story__facts dt {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--c-blue);
  }
  .story__facts dd {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: rgb(89, 100, 107);
  }

  .story__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 30px;
    object-fit: cover;
  }

  @media (max-width: 999.98px) {
    .story__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .story__photo {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 809.98px) {
    .story {
      width: auto;
      padding: 60px 20px;
    }
    .story__title {
      font-size: 35px;
    }
    .story__text {
      font-size: 15px;
    }
    .story__facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .story__photo {
      border-radius: 20px;
    }
  }
</style>
