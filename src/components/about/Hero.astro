---
import LoopVideo from './LoopVideo.astro';
---

<section class="hero" aria-labelledby="about-title">
  <div class="hero__intro">
    <h1 class="hero__title" id="about-title">About Us</h1>
    <p class="hero__tagline" data-reveal style="--reveal-distance:20px;--reveal-delay:200ms">
      Building the Future Together
    </p>
    <p class="hero__lead" data-reveal style="--reveal-distance:20px;--reveal-delay:300ms">
      At ALPHV Technologies, we go <strong>beyond</strong> being a system integrator. We are <strong
        class="text-blue">builders</strong>, <strong class="text-blue">educators</strong>, and <strong
        class="text-blue">community enablers</strong>, crafting an ecosystem where businesses grow, developers thrive,
      and innovation flourishes.
    </p>
    <p class="tag hero__badge" data-reveal style="--reveal-distance:20px;--reveal-delay:100ms">
      <span class="tag__dot" aria-hidden="true"></span>50,000+ Developers. Countless Possibilities.
    </p>
  </div>

  <!-- Illustration collage: "Code • Build • Repeat •" badge, #ALPHV, code windows (animated video). -->
  <div class="hero__media">
    <LoopVideo src="/assets/Ccdk3b41CaOc7CZjqmGBNOJWc.mp4" eager />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    padding: 80px 20px;
    background: var(--c-white);
    overflow: hidden;
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 90%;
  }

  .hero__title {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: center;
    color: var(--c-black);
    font-feature-settings: 'cv01', 'cv09', 'cv11', 'cv05', 'ss03';
  }

  .hero__tagline {
    width: 100%;
    font-family: var(--font-inter);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--c-black);
  }

  .hero__lead {
    width: 80%;
    font-size: 20px;
    font-weight: 500;
    line-height: 2;
    text-align: center;
    color: var(--c-text);
  }
  .hero__lead strong { font-weight: 700; }

  /* Framer "Spots Badge" sizing on top of the shared .tag primitive. */
  .hero__badge {
    gap: 10px;
    padding: 7px 15px;
    border: 0;
    box-shadow: inset 0 0 0 1px #f5f5f5, 0 1px 2px rgba(0, 0, 0, 0.05);
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.7);
  }
  .hero__badge .tag__dot { box-shadow: 0 0 4px 4px rgba(28, 100, 255, 0.2); }

  .hero__media {
    width: 90%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
  }

  @media (max-width: 809.98px) {
    .hero__intro { width: 100%; }
    .hero__title { font-size: 20px; }
    .hero__tagline { font-size: 35px; }
    .hero__lead { width: 100%; font-size: 14px; }
    .hero__media { width: 100%; }
  }
</style>
