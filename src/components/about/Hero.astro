---
// About hero: intro copy over a mosaic of real ALPHV photos (Academy cohort, Technologies team,
// Developer Kaki meetup). Replaces the earlier animated illustration video.
import { url } from '../../lib/paths';

const photos = [
  { src: '/images/about-academy-cohort.jpg', alt: 'An ALPHV Academy training cohort', w: 1600, h: 1067 },
  { src: '/images/technologies-team-booth.jpg', alt: 'The ALPHV Technologies team at its exhibition booth', w: 952, h: 899 },
  { src: '/images/devrel-developer-kaki-meetup.jpg', alt: 'Developers at a Developer Kaki community meetup', w: 1080, h: 1020 },
];
---

<section class="hero" aria-labelledby="about-title">
  <div class="hero__intro">
    <h1 class="hero__title" id="about-title">About Us</h1>
    <p class="hero__tagline" data-reveal style="--reveal-distance:20px;--reveal-delay:200ms">
      Building the Future Together
    </p>
    <p class="hero__lead" data-reveal style="--reveal-distance:20px;--reveal-delay:300ms">
      ALPHV is a technology group headquartered in Kuala Lumpur, with its parent company in Singapore. Through four
      specialised companies, we help organisations <strong class="text-blue">adopt AI</strong>, <strong
        class="text-blue">upskill their teams</strong>, <strong class="text-blue">reach developers</strong> and <strong
        class="text-blue">hire technical talent</strong>.
    </p>
    <p class="tag hero__badge" data-reveal style="--reveal-distance:20px;--reveal-delay:100ms">
      <span class="tag__dot" aria-hidden="true"></span>82,000+ Developers. Countless Possibilities.
    </p>
  </div>

  <div class="hero__media" data-reveal style="--reveal-distance:30px;--reveal-delay:300ms">
    {
      photos.map((p, i) => (
        <img
          class={`hero__photo hero__photo--${i + 1}`}
          src={url(p.src)}
          alt={p.alt}
          width={p.w}
          height={p.h}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))
    }
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
    padding: 80px 20px;
    background: var(--c-white);
    overflow: hidden;
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 90%;
  }

  .hero__title {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: center;
    color: var(--c-black);
    font-feature-settings: 'cv01', 'cv09', 'cv11', 'cv05', 'ss03';
  }

  .hero__tagline {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 55px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-align: center;
    color: var(--c-text);
  }

  .hero__lead {
    width: 80%;
    font-size: 20px;
    font-weight: 500;
    line-height: 2;
    text-align: center;
    color: var(--c-text);
  }
  .hero__lead strong { font-weight: 700; }

  /* Framer "Spots Badge" sizing on top of the shared .tag primitive. */
  .hero__badge {
    gap: 10px;
    padding: 7px 15px;
    border: 0;
    box-shadow: inset 0 0 0 1px #f5f5f5, 0 1px 2px rgba(0, 0, 0, 0.05);
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.7);
  }
  .hero__badge .tag__dot { box-shadow: 0 0 4px 4px rgba(28, 100, 255, 0.2); }

  .hero__media {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    width: 90%;
    max-width: 1200px;
    height: 560px;
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 24px;
    object-fit: cover;
  }
  .hero__photo--1 { grid-row: 1 / span 2; }

  @media (max-width: 809.98px) {
    .hero__intro { width: 100%; }
    .hero__title { font-size: 20px; }
    .hero__tagline { font-size: 35px; }
    .hero__lead { width: 100%; font-size: 14px; }
    .hero__media {
      width: 100%;
      height: auto;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 10px;
    }
    .hero__photo { aspect-ratio: 1; border-radius: 16px; }
    .hero__photo--1 { grid-column: 1 / span 2; grid-row: auto; aspect-ratio: 3 / 2; }
  }
</style>
