---
/**
 * Muted, looping background video (Framer "Video" component replacement).
 * Fills its parent (size/radius the wrapper), plays only while near the viewport
 * and stays paused for visitors who prefer reduced motion.
 */
import { url } from '../../lib/paths';

interface Props {
  src: string;
  /** Above-the-fold videos start loading/playing immediately. */
  eager?: boolean;
}

const { src, eager = false } = Astro.props;
---

<video
  class="loop-video"
  src={url(src)}
  width="1920"
  height="1080"
  muted
  loop
  playsinline
  autoplay={eager}
  preload={eager ? 'auto' : 'metadata'}
  aria-hidden="true"
  tabindex="-1"
  data-loop-video
></video>

<style>
  .loop-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: transparent;
  }
</style>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-loop-video]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const play = (v: HTMLVideoElement) => {
    if (reduce.matches) return v.pause();
    v.play().catch(() => {});
  };

  if (!('IntersectionObserver' in window)) {
    videos.forEach(play);
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) play(v);
          else v.pause();
        }
      },
      { rootMargin: '200px 0px' }
    );
    videos.forEach((v) => io.observe(v));
  }
</script>
