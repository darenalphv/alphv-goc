---

<section class="expertise" aria-labelledby="expertise-title">
  <div class="expertise__head">
    <h2
      class="expertise__title"
      id="expertise-title"
      data-reveal="left"
      style="--reveal-distance: 30px; --reveal-delay: 200ms"
    >
      <span class="text-blue">Featured</span> Expertise
    </h2>
  </div>

  <ul class="expertise__list">
    {
      items.map((item, i) => (
        <li
          class="expertise__pill"
          data-reveal="left"
          style={`--reveal-distance: 50px; --reveal-delay: ${(i + 1) * 50}ms`}
        >
          <svg class="expertise__icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
            <path d={item.path} />
          </svg>
          <span>{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .expertise {
    padding-top: 120px;
  }

  .expertise__head {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px 0;
  }

  .expertise__title {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 45px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    color: var(--c-text);
  }

  .expertise__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }

  .expertise__pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 19px; /* 20px in Framer, whose 1px border is drawn inside the box */
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: 20px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
    color: var(--c-black);
    white-space: nowrap;
  }

  .expertise__icon {
    flex: none;
    width: 20px;
    height: 20px;
    fill: var(--c-blue);
  }

  @media (max-width: 809.98px) {
    /* Framer pins the heading frame to 145px; the two-line heading overflows it evenly. */
    .expertise__head {
      height: 145px;
    }

    .expertise__list {
      width: 80%;
    }

    .expertise__pill {
      max-width: 100%;
    }
  }
</style>
