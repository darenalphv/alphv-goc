---
// "Section PROJECTS" — the four service cards (Framer "Project Card" component).
// Desktop: 2×2 grid inside a 1200px column. Tablet/phone: single column.
// Every card links to the home page on the live site (href "./" from /service).
// Hover: the title turns brand blue.
import { url } from '../../lib/paths';

interface ServiceCard {
  title: string;
  subtitle: string;
  image: string;
  alt: string;
}

const cards: ServiceCard[] = [
  {
    title: 'System & Software Development',
    subtitle: 'Smarter systems, better productivity, scalable growth.',
    image: '/images/GHa4BAjiwhelgAStwsITxXFvryI.png',
    alt: 'Developer presenting code on a tablet to teammates at a desk',
  },
  {
    title: 'ALPHV Academy',
    subtitle: 'Upskilling the next generation of talent.',
    image: '/images/SOrmO2Qh38Nw0M9JFjVFQM8LtA.png',
    alt: 'ALPHV Academy logo over students coding at a computer',
  },
  {
    title: 'Developer Relations (DevRel)',
    subtitle: 'Building the strongest tech community ecosystem.',
    image: '/images/7ZQDTSHuvaFB1wUQmmJo8Jcws.png',
    alt: 'Team members joining hands in a high five around a meeting table',
  },
  {
    title: 'ALPHV Recruit',
    subtitle: 'Connecting talent with opportunity.',
    image: '/images/rqiIGDbeDRiobhyef2bGIyvLg.png',
    alt: 'Hand selecting a candidate icon from a row of profile icons',
  },
];
---

<section class="cards" id="case-studies" aria-label="Our services">
  <ul class="cards__grid">
    {
      cards.map((card, i) => (
        <li class="cards__item" data-reveal style="--reveal-distance: 200px">
          <a class="svc-card" href={url('/')}>
            <div class="svc-card__media">
              <img
                src={url(card.image)}
                alt={card.alt}
                width="1080"
                height="1080"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </div>
            <div class="svc-card__text">
              <h2 class="svc-card__title">{card.title}</h2>
              <p class="svc-card__subtitle">
                <em>{card.subtitle}</em>
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cards {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding: 0 100px;
    scroll-margin-top: 30px;
  }

  .cards__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(200px, 1fr));
    gap: 28px;
    max-width: 1200px;
    margin-inline: auto;
  }

  /* Framer appear: y 200 → 0, tween cubic-bezier(.44,0,.56,1) 0.7s */
  html.js .cards__item[data-reveal] {
    transition-duration: 0.7s;
    transition-timing-function: cubic-bezier(0.44, 0, 0.56, 1);
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding: 5px;
    color: inherit;
  }

  .svc-card__media {
    display: block;
    width: 100%;
    aspect-ratio: 1.05882;
    border-radius: 50px;
    overflow: hidden;
  }

  .svc-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .svc-card__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .svc-card__title {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    color: rgb(6, 6, 8);
    transition: color 0.3s ease;
  }

  .svc-card:hover .svc-card__title,
  .svc-card:focus-visible .svc-card__title {
    color: var(--c-blue);
  }

  .svc-card__subtitle {
    font-family: var(--font-inter-tight);
    font-size: 16px;
    line-height: 28px;
    color: rgb(92, 92, 106);
  }

  /* Tablet: one card per row, full-width images */
  @media (max-width: 1199.98px) {
    .cards {
      padding: 0 20px;
    }

    .cards__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Phone: wide-format images, smaller type */
  @media (max-width: 809.98px) {
    .svc-card__media {
      aspect-ratio: 1.64571;
    }

    .svc-card__title {
      font-size: 16px;
    }

    /* Live quirk: titles 2–4 sit in a bolder <strong> on phone, which also adds 1px of line height. */
    .cards__item:not(:first-child) .svc-card__title {
      font-weight: 800;
      line-height: 21px;
    }

    .svc-card__subtitle {
      font-size: 12px;
    }
  }
</style>
