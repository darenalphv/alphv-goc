---
// "Section PROJECTS" — the four service cards (Framer "Project Card" component).
// Desktop: 2×2 grid inside a 1200px column. Tablet/phone: single column.
// Each card links out to that company's own site and lists its main services.
// Hover: the title turns brand blue.
import { url } from '../../lib/paths';

interface ServiceCard {
  title: string;
  subtitle: string;
  href: string;
  domain: string;
  services: string[];
  image: string;
  alt: string;
}

const cards: ServiceCard[] = [
  {
    title: 'ALPHV Technologies',
    subtitle: 'AI systems integration and software development.',
    href: 'https://alphv.com',
    domain: 'alphv.com',
    services: ['AI engineering', 'Agentic automation', 'System integration', 'Computer vision', 'Web & mobile apps'],
    image: '/images/technologies-team-booth.jpg',
    alt: 'The ALPHV Technologies team at its exhibition booth',
  },
  {
    title: 'ALPHV Academy',
    subtitle: 'HRDC-certified AI, data and leadership training.',
    href: 'https://academy.alphv.com',
    domain: 'academy.alphv.com',
    services: ['Tech certification programs', 'AI train-the-trainer', 'GenAI & data workshops', 'Bootcamps & talks'],
    image: '/images/academy-training-session.jpg',
    alt: 'An ALPHV Academy trainer presenting to a class beside an ALPHV banner',
  },
  {
    title: 'ALPHV DevRel',
    subtitle: 'Developer relations and the 75,000-strong Developer Kaki community.',
    href: 'https://devrel.alphv.com',
    domain: 'devrel.alphv.com',
    services: ['Developer marketing', 'Engagement events', 'Hackathons', 'Executive roundtables'],
    image: '/images/devrel-developer-kaki-meetup.jpg',
    alt: 'Developers posing beside a Developer Kaki banner at a community meetup',
  },
  {
    title: 'ALPHV Recruit',
    subtitle: 'Tech recruitment and executive search across Southeast Asia.',
    href: 'https://recruit.alphv.com',
    domain: 'recruit.alphv.com',
    services: ['Executive search', 'Tech talent recruiting', 'Contract staffing', 'Talent advisory'],
    image: '/images/recruit-interview-handshake.jpg',
    alt: 'A candidate and interviewer shaking hands across a desk',
  },
];
---

<section class="cards" id="case-studies" aria-label="Our companies">
  <ul class="cards__grid">
    {
      cards.map((card, i) => (
        <li class="cards__item" data-reveal style="--reveal-distance: 200px">
          <a class="svc-card" href={card.href} target="_blank" rel="noopener">
            <div class="svc-card__media">
              <img
                src={url(card.image)}
                alt={card.alt}
                width="1080"
                height="1020"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </div>
            <div class="svc-card__text">
              <h2 class="svc-card__title">{card.title}</h2>
              <p class="svc-card__subtitle">{card.subtitle}</p>
              <ul class="svc-card__tags" aria-label={`${card.title} services`}>
                {card.services.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <span class="svc-card__go">
                Visit {card.domain} <span aria-hidden="true">↗</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cards {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding: 0 100px;
    scroll-margin-top: 30px;
  }

  .cards__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(200px, 1fr));
    gap: 28px;
    max-width: 1200px;
    margin-inline: auto;
  }

  /* Framer appear: y 200 → 0, tween cubic-bezier(.44,0,.56,1) 0.7s */
  html.js .cards__item[data-reveal] {
    transition-duration: 0.7s;
    transition-timing-function: cubic-bezier(0.44, 0, 0.56, 1);
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding: 5px;
    color: inherit;
  }

  .svc-card__media {
    display: block;
    width: 100%;
    aspect-ratio: 1.05882;
    border-radius: 50px;
    overflow: hidden;
  }

  .svc-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .svc-card__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .svc-card__title {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    color: rgb(6, 6, 8);
    transition: color 0.3s ease;
  }

  .svc-card:hover .svc-card__title,
  .svc-card:focus-visible .svc-card__title {
    color: var(--c-blue);
  }

  .svc-card__subtitle {
    font-family: var(--font-inter);
    font-size: 16px;
    line-height: 26px;
    color: rgb(92, 92, 106);
  }
  .svc-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .svc-card__tags li {
    padding: 5px 12px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 500;
    color: var(--c-text);
  }
  .svc-card__go {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-blue);
  }

  /* Tablet: one card per row, full-width images */
  @media (max-width: 1199.98px) {
    .cards {
      padding: 0 20px;
    }

    .cards__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Phone: wide-format images, smaller type */
  @media (max-width: 809.98px) {
    .svc-card__media {
      aspect-ratio: 1.64571;
    }

    .svc-card__title {
      font-size: 20px;
    }

    .svc-card__subtitle {
      font-size: 14px;
      line-height: 22px;
    }
  }
</style>
