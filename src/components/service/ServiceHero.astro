---
// Service page hero — Framer frame "Hero" (padding 80px 20px, identical at every breakpoint).
// The eyebrow is a centred tag pill, matching the home hero.
---

<section class="hero">
  <div class="hero__inner">
    <p class="tag hero__eyebrow"><span class="tag__dot" aria-hidden="true"></span>Our Companies</p>
    <h1 class="hero__title" data-reveal style="--reveal-distance: 20px; --reveal-delay: 200ms">
      We <span class="text-blue">Build</span> What Matters
    </h1>
    <p class="hero__lead" data-reveal style="--reveal-distance: 20px; --reveal-delay: 300ms">
      Four companies, one ecosystem. From production AI to training, developer communities and tech recruitment,
      ALPHV helps businesses scale and developers thrive.
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 80px 20px;
    background: var(--c-white);
    overflow: hidden;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero__eyebrow {
    gap: 10px;
    padding: 7px 15px;
    border: 0;
    box-shadow:
      inset 0 0 0 1px #f5f5f5,
      0 1px 2px rgba(0, 0, 0, 0.05);
    font-size: 12px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.7);
  }
  .hero__eyebrow .tag__dot {
    box-shadow: 0 0 4px 4px rgba(28, 100, 255, 0.2);
  }

  .hero__title {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 55px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.4;
    text-align: center;
    color: var(--c-text);
  }

  .hero__lead {
    width: 80%;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 2;
    text-align: center;
    color: var(--c-text);
  }
</style>
