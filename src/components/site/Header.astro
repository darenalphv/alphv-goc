---
// Sticky site header: logo, primary links and the contact button. Below 900px the links collapse
// into a full-width panel toggled by the menu button.
import { url } from '../../lib/paths';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const links = [
  { label: 'Companies', href: url('/service'), key: '/service' },
  { label: 'About', href: url('/about-us'), key: '/about-us' },
  { label: 'Careers', href: 'https://recruit.alphv.com', external: true },
];
---

<header class="header" data-header>
  <div class="wrap header__bar">
    <a class="header__logo" href={url('/')} aria-label="ALPHV group home">
      <Logo />
    </a>

    <nav class="header__nav" id="site-nav" aria-label="Main" data-nav>
      <ul class="header__links">
        {
          links.map((l) => (
            <li>
              <a
                class="header__link"
                href={l.href}
                aria-current={l.key && l.key === current ? 'page' : undefined}
                {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {l.label}
                {l.external && <Icon name="arrow-up-right" size={14} />}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary header__cta" href={url('/contact-us')}>Contact</a>
    </nav>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={20} class="header__icon header__icon--open" />
      <Icon name="x" size={20} class="header__icon header__icon--close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  if (header && toggle) {
    const set = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(!header.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
    matchMedia('(min-width: 901px)').addEventListener('change', () => set(false));
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: var(--hairline);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 76px;
  }
  .header__logo {
    display: block;
  }
  .header__logo :global(.logo) {
    height: 40px;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .header__links {
    display: flex;
    gap: 32px;
  }
  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding-block: 8px;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-variation-settings: 'wdth' 125;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .header__link:hover {
    color: var(--blue);
  }
  .header__link[aria-current='page'] {
    border-bottom-color: var(--blue);
  }
  .header__cta {
    min-height: 44px;
  }
  .header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid var(--black);
    background: var(--white);
    cursor: pointer;
  }
  .header__toggle :global(.header__icon) {
    margin: auto;
  }
  .header__toggle :global(.header__icon--close) {
    display: none;
  }

  @media (max-width: 900px) {
    .header__toggle {
      display: block;
    }
    .header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      background: var(--white);
      border-bottom: var(--rule);
    }
    .header.is-open .header__nav {
      display: flex;
    }
    .header.is-open :global(.header__icon--open) {
      display: none;
    }
    .header.is-open :global(.header__icon--close) {
      display: block;
    }
    .header__links {
      flex-direction: column;
      gap: 0;
      margin-bottom: 20px;
    }
    .header__link {
      display: flex;
      justify-content: space-between;
      padding-block: 18px;
      font-size: 16px;
      border-bottom: var(--hairline);
    }
    .header__link[aria-current='page'] {
      color: var(--blue);
      border-bottom-color: var(--n-200);
    }
  }
</style>
