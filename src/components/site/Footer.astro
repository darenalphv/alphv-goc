---
// Site footer: black field, white lockup, group and company links, contact details and legal entities.
import { url } from '../../lib/paths';
import Logo from '../ui/Logo.astro';
import { companies, contact, entities, socials } from '../../data/group';

const year = new Date().getFullYear();
---

<footer class="footer section--black">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <a href={url('/')} aria-label="ALPHV group home"><Logo variant="white" /></a>
        <p class="footer__tagline h3">Welcome to the peak.</p>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        <div>
          <h2 class="label footer__heading">Companies</h2>
          <ul class="footer__list">
            {
              companies.map((c) => (
                <li>
                  <a href={c.url} target="_blank" rel="noopener">
                    {c.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="label footer__heading">Group</h2>
          <ul class="footer__list">
            <li><a href={url('/service')}>Our companies</a></li>
            <li><a href={url('/about-us')}>About</a></li>
            <li><a href="https://recruit.alphv.com" target="_blank" rel="noopener">Careers</a></li>
            <li><a href={url('/contact-us')}>Contact</a></li>
          </ul>
        </div>
        <div>
          <h2 class="label footer__heading">Contact</h2>
          <ul class="footer__list">
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><a href={contact.phoneHref}>{contact.phone}</a></li>
            <li><a href={contact.recruitPhoneHref}>Recruit {contact.recruitPhone}</a></li>
          </ul>
          <address class="footer__address">{contact.address.join(', ')}</address>
        </div>
        <div>
          <h2 class="label footer__heading">Follow</h2>
          <ul class="footer__list">
            {
              socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer__legal">
      <ul>
        {
          entities.map((e) => (
            <li>
              {e.name} _ {e.reg} _ {e.note}
            </li>
          ))
        }
      </ul>
      <p>ALPHV GROUP | © {year}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 80px 32px;
  }
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: 48px;
    padding-bottom: 64px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .footer__brand :global(.logo) {
    height: 44px;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .footer__heading {
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--white);
  }
  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }
  .footer__list a {
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .footer__list a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__address {
    margin-top: 16px;
    font-size: 13px;
    font-style: normal;
    line-height: 1.5;
    opacity: 0.55;
  }
  .footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--white);
    font-family: var(--font-display);
    font-stretch: 125%;
    font-variation-settings: 'wdth' 125;
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .footer__legal ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (max-width: 1100px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer__legal {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
