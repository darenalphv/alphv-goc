---
/**
 * Home — "Press Section" ("Media Carousel" component).
 *
 * The live carousel is a two-page grid (auto-fill, min 280px columns) toggled by the
 * prev/next arrows. Each breakpoint shows a different slice of the 10 CMS articles:
 *   ultra-wide ≥1440: page 1 = 1–8, page 2 = 9–10
 *   desktop 1200–1439: page 1 = 1–6, page 2 = 7–10
 *   tablet 810–1199:   page 1 = 1–4, page 2 = 5–8
 *   phone <810:        page 1 = 1–3, page 2 = 4–6
 * Both arrows flip between the two pages, exactly like the Framer variants.
 */
import { url } from '../../lib/paths';

const logos = {
  fpt: { src: '/images/ev0dSzv4gmoeLWCS0epD1ijMvo.png', alt: 'FPT' },
  fptAi: { src: '/images/TyVFTWn1qHFolKjJ05QzO2z8M.png', alt: 'FPT AI Factory' },
  bfm: { src: '/images/PnHH6NVU3XStzFoOG8LGwh9NToo.png', alt: 'BFM 89.9' },
  star: { src: '/images/rbNZu2Mt1nhbuALHgPjdTOio3U.png', alt: 'The Star' },
  malayMail: { src: '/images/zUWUVJn1M7Q6ffJpPanJ9uYVRKo.png', alt: 'Malay Mail' },
};

const articles = [
  {
    title: 'FPT and ALPHV partner to accelerate AI innovation in Malaysia',
    href: 'https://fpt.com/en/news/fpt-news/fpt-va-alphv-hop-tac-thuc-day-doi-moi-sang-tao-ai-tai-malaysia',
    date: '2026-04-29',
    image: { src: '/images/fipDVvUmzMNHli9yEbdgbvYzGw.jpg', width: 1920, height: 1080 },
    logo: logos.fpt,
  },
  {
    title: 'FPT AI Factory and ALPHV Announce Strategic Partnership to Accelerate AI Innovation in Malaysia',
    href: 'https://factory.fpt.ai/news/fpt-ai-factory-and-alphv-announce-strategic-partnership-to-accelerate-ai-innovation-in-malaysia',
    date: '2026-04-24',
    image: { src: '/images/IImczZfxh3mIyzP3njoNLyx1pU.jpg', width: 1920, height: 1080 },
    logo: logos.fptAi,
  },
  {
    title: '$100K AI Bills? 4 Drivers of Token Bill Shock',
    href: 'https://www.bfm.my/content/podcast/dollar100k-ai-bills-4-drivers-of-token-bill-shock',
    date: '2026-03-19',
    image: { src: '/images/FpLUgpj960i6NCuGWHwwXiYjCGM.png', width: 1178, height: 617 },
    logo: logos.bfm,
  },
  {
    title: 'Shadow AI & The True Cost Of LLMs',
    href: 'https://www.bfm.my/content/podcast/shadow-ai-and-the-true-cost-of-llms',
    date: '2026-03-12',
    image: { src: '/images/nksUzWrAVCQZTB6MttyddZZFuqE.png', width: 1178, height: 617 },
    logo: logos.bfm,
  },
  {
    title: 'The rise of vibe coding: Programming made easy with AI',
    href: 'https://www.thestar.com.my/tech/tech-news/2025/09/01/the-rise-of-vibe-coding-programming-made-easy-with-ai',
    date: '2025-09-01',
    image: { src: '/images/7X4bxQQaScamXAHWf2dIytK8Bw.jpg', width: 1240, height: 694 },
    logo: logos.star,
  },
  {
    title: 'Coding 101: Is AI rewriting the rules?',
    href: 'https://www.thestar.com.my/tech/2025/03/17/coding-101-is-ai-rewriting-the-rules',
    date: '2025-03-17',
    image: { src: '/images/7MyL0pIzWoqYUmdTiD4P8KamHA.jpg', width: 1240, height: 1106 },
    logo: logos.star,
  },
  {
    title: 'How This Freelancer Dev Built a Fast-Growing Tech Biz',
    href: 'https://www.bfm.my/content/podcast/how-this-freelancer-dev-built-a-fast-growing-tech-biz',
    date: '2025-02-27',
    image: { src: '/images/h55UlhNRAAV3j2E6XUUtp3fzY0g.png', width: 1178, height: 617 },
    logo: logos.bfm,
  },
  {
    title: 'Reporting bugs without backlash: Towards fixing flaws without fear',
    href: 'https://www.thestar.com.my/tech/tech-news/2025/02/10/reporting-bugs-without-backlash-towards-fixing-flaws-without-fear',
    date: '2025-02-10',
    image: { src: '/images/6eH3QlvGRTYZMULFAOSUd5A8EE4.jpeg', width: 1240, height: 827 },
    logo: logos.star,
  },
  {
    title: 'Navigating the tech startup challenge: Two technopreneurs share their stories',
    href: 'https://www.malaymail.com/news/malaysia/2024/08/07/navigating-the-tech-startup-challenge-two-technopreneurs-share-their-stories/145060',
    date: '2024-08-07',
