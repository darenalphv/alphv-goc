---
// Home — careers strip that points to ALPHV Recruit's open roles. (The Build / Train / Grow / Hire
// stages now label the service cards in Services.astro instead of repeating them here.)
---

<section class="flow" aria-label="Careers">
  <div class="flow__careers" data-reveal style="--reveal-distance: 30px">
    <div>
      <h3 class="flow__careers-title">Careers at ALPHV</h3>
      <p class="flow__careers-body">
        Join a 100% local team shipping AI into production, or browse the roles ALPHV Recruit is hiring for right now.
      </p>
    </div>
    <a class="btn btn--primary" href="https://recruit.alphv.com" target="_blank" rel="noopener">
      <span>See open roles</span>
    </a>
  </div>
</section>

<style>
  .flow {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding: 0 100px 60px;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }
  .flow__careers {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 32px 36px;
    border-radius: var(--radius-xl);
    background: var(--c-dark);
    color: var(--c-white);
  }
  .flow__careers-title {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .flow__careers-body {
    margin-top: 8px;
    max-width: 560px;
    font-family: var(--font-inter);
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 1199px) {
    .flow {
      padding: 0 40px 40px;
    }
  }
  @media (max-width: 809px) {
    .flow {
      padding: 0 20px 30px;
      gap: 36px;
    }
    .flow__careers {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
