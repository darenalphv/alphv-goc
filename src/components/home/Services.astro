---
// Home — "Services Section" (#services): intro heading + paragraph, "Our Group of Companies"
// logos with captions, the 4-card services bento (labelled Build / Train / Grow / Hire), the CEO
// quote and the linked "More Services" pills.
import { url } from '../../lib/paths';
import Icon from './a/Icon.astro';
import ServiceCard from './a/ServiceCard.astro';

const companies = [
  { href: 'https://alphv.com', src: '/images/hwb44JkUHK1ej38Ap2SZO0X0sc.png', alt: 'ALPHV Technology', caption: 'Technologies', w: 290, h: 138 },
  { href: 'https://academy.alphv.com/', src: '/images/sEHPe4LvaMSZJQ4Q7pHnDhayo.png', alt: 'ALPHV Academy', caption: 'Academy', w: 290, h: 138 },
  { href: 'https://devrel.alphv.com/', src: '/images/yaTuWTNK4kISTNQoWMKPCnEnYmQ.png', alt: 'ALPHV DevRel', caption: 'DevRel', w: 290, h: 138 },
  { href: 'https://recruit.alphv.com/', src: '/images/hWMaJ653nab1sdeWJnht0n5LnI0.png', alt: 'ALPHV Recruit', caption: 'Recruit', w: 290, h: 138 },
  { href: 'https://jobs.developerkaki.my/', src: '/images/NwN1DZpJzC6EoWRyE09bhCwVkQ.png', alt: 'Jobs by Developer Kaki', caption: 'Kaki Jobs', w: 288, h: 154 },
];

// Each pill links to the company that offers it.
const tech = 'https://alphv.com';
const moreServices = [
  { icon: 'app-window', label: 'Software', href: tech },
  { icon: 'hexagon', label: 'AI & Machine Learning', href: tech },
  { icon: 'cloud', label: 'Cloud', href: tech },
  { icon: 'chart-line', label: 'Analytics', href: tech },
  { icon: 'sparkle', label: 'Integration', href: tech },
  { icon: 'book', label: 'Training', href: 'https://academy.alphv.com' },
  { icon: 'search', label: 'Recruit', href: 'https://recruit.alphv.com' },
  { icon: 'code-window', label: 'Devrel', href: 'https://devrel.alphv.com' },
  { icon: 'cube', label: 'Hackathons', href: 'https://devrel.alphv.com' },
  { icon: 'info', label: 'Consulting', href: tech },
] as const;
---

<section id="services" class="services">
  <div class="intro">
    <div class="intro__heading">
      <p class="eyebrow" data-reveal="left" style="--reveal-distance: 30px; --reveal-delay: 100ms">
        <Icon name="stack" class="eyebrow__icon" />
        <span>What Do we do ?</span>
        <span class="eyebrow__line" aria-hidden="true"></span>
      </p>
      <h2 class="intro__title" data-reveal="left" style="--reveal-distance: 30px; --reveal-delay: 200ms">
        <span class="muted">We </span><span class="ink">Build </span>Technology<span class="muted">.</span><br />
        <span class="muted">We </span><span class="ink-soft">Train </span>Talents<span class="muted">.</span><br />
        <span class="muted">We </span><span class="ink">Grow </span>Communities<span class="muted">.</span><br />
        <span class="muted">We </span><span class="ink">Shape</span><span class="muted"> the </span>Future<span class="muted">.</span>
      </h2>
    </div>
    <p class="intro__lead" data-reveal="left" style="--reveal-distance: 30px; --reveal-delay: 300ms">
      ALPHV is a Kuala Lumpur-based group of companies. Four businesses, one ecosystem: we build production AI and
      software, train teams, grow Southeast Asia's largest developer community and place the people who build what's
      next.
    </p>
  </div>

  <div class="group">
    <h3 class="group__label" data-reveal style="--reveal-distance: 20px">Our Group of Companies</h3>
    <ul class="group__logos">
      {
        companies.map((c, i) => (
          <li class:list={['group__item', { 'group__item--lead': i === 0 }]}>
            <a href={c.href} target="_blank" rel="noopener">
              <img src={url(c.src)} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" />
              <span class="group__caption">{c.caption} <span aria-hidden="true">↗</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="bento">
    <div class="bento__col bento__col--a">
      <ServiceCard
        icon="code"
        title="AI & Software Engineering"
        category="01 · Build"
        href="https://alphv.com/"
        newTab
        revealDelay={200}
      >
        We design, integrate and run production AI for legal, insurance, healthcare, hospitality, finance and retail
        teams, from the first model to measurable outcomes.
      </ServiceCard>
      <ServiceCard
        icon="users-four"
        title="Developer Relations"
        category="03 · Grow"
        href="https://devrel.alphv.com/"
        fill
        photos={['/images/9jvJVjkD9jYYoV2ZAZqw2jnkM0.jpg', '/images/ymH6jZJosdsDDJ5qxRmRflBA.jpg']}
        revealDelay={300}
      >
        We connect 75,000+<span class="ws">{'  '}</span>developers<span class="ws">{'  '}</span>with tech companies through strategic <strong>campaigns, meetups </strong>and
        immersive <strong>hackathons</strong>.
      </ServiceCard>
    </div>
    <div class="bento__col bento__col--b">
      <ServiceCard
        icon="dna"
        title="Training & Upskilling"
        category="02 · Train"
        href="https://academy.alphv.com/"
        newTab
        fill
        photos={['/images/qiplSkiBBYKKxgegzuqc7GQYBY.jpg', '/images/M73iDdjZDAZh0MTOxJLNhPJojA.jpg']}
        revealDelay={300}
      >
        HRDC-certified programs in AI, data science and emerging technology for individuals and enterprise teams.
        Hands-on, practitioner-led, with the HRD Corp paperwork handled for you.
      </ServiceCard>
      <ServiceCard
        icon="notebook"
        title="Tech Recruitment"
        category="04 · Hire"
        href="http://recruit.alphv.com/"
        newTab
        revealDelay={200}
      >
        Data-driven executive search and tech recruitment across Malaysia and Southeast Asia, from a single C-suite hire
        to whole engineering teams, with a replacement guarantee on every placement.
      </ServiceCard>
    </div>
  </div>

  <figure class="quote" data-reveal style="--reveal-distance: 30px; --reveal-delay: 200ms">
    <img
      class="quote__photo"
      src={url('/images/cgPZRqrv944rtuZzDHsax8LAuI.png')}
      alt="Daren Tan speaking on stage"
      width="1080"
      height="1080"
      loading="lazy"
      decoding="async"
    />
    <div class="quote__body">
      <span class="quote__mark" aria-hidden="true">“</span>
      <blockquote class="quote__text">
        <p>
          We're Malaysia's AI-native system integrator, building intelligent solutions while growing Asia's largest
          developer community, and empowering your team to innovate with confidence.
        </p>
      </blockquote>
      <figcaption class="quote__by">
        <strong>Daren Tan</strong>
        <span>CEO, ALPHV</span>
      </figcaption>
    </div>
  </figure>

  <ul class="more" aria-label="More services">
    {
      moreServices.map((s, i) => (
        <li data-reveal="left" style={`--reveal-distance: 50px; --reveal-delay: ${(i + 1) * 50}ms`}>
          <a class="pill" href={s.href} target="_blank" rel="noopener">
            <Icon name={s.icon} class="pill__icon" />
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 70px;
    width: 90%;
    margin-inline: auto;
    padding: 80px 0 100px;
    scroll-margin-top: 50px;
  }

  /* ---------- Intro ---------- */
  .intro {
    display: flex;
    align-items: center;
    gap: 80px;
    width: 100%;
    max-width: 1200px;
  }
  .intro__heading {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--c-blue);
    white-space: nowrap;
  }
  .eyebrow :global(.eyebrow__icon) { flex: none; width: 20px; height: 20px; }
  .eyebrow__line {
    flex: none;
    width: 50px;
    height: 1px;
    background: var(--c-blue);
    -webkit-mask: linear-gradient(270deg, transparent 0%, #000 100%);
    mask: linear-gradient(270deg, transparent 0%, #000 100%);
  }
  .intro__title {
    width: 100%;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--c-blue);
  }
  .muted { color: rgba(109, 122, 130, 0.7); }
  /* Preserves the live copy's double spaces (Framer text is white-space: pre-wrap). */
  .ws { white-space: pre-wrap; }
  .ink { color: rgb(17, 17, 17); }
  .ink-soft { color: rgb(51, 51, 51); }
  .intro__lead {
    flex: 1 1 0;
    min-width: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.8;
    color: rgb(89, 100, 107);
  }

  /* ---------- Our Group of Companies ---------- */
  .group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  .group__label {
    width: 100%;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
    color: rgba(0, 0, 0, 0.5);
  }
  .group__logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    width: 100%;
  }
  .group__item { flex: none; width: 150px; }
  .group__item a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 6px 4px 10px;
    border-radius: 14px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .group__item a:hover { background: var(--c-surface); }
  .group__item img { width: 100%; height: 73px; object-fit: contain; }
  .group__caption {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    color: rgb(89, 100, 107);
  }
  .group__item a:hover .group__caption { color: var(--c-blue); }

  /* ---------- Bento ---------- */
  .bento {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    width: 100%;
    max-width: 1200px;
  }
  .bento__col {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-width: 0;
    height: 685px;
  }

  /* ---------- CEO quote ---------- */
  .quote {
    display: flex;
    align-items: center;
    gap: 40px;
    width: 100%;
    max-width: 1000px;
    padding: 30px;
    border: 1px solid var(--c-border);
    border-radius: 30px;
    background: var(--c-surface);
  }
  .quote__photo {
    flex: none;
    width: 180px;
    height: 180px;
    border-radius: 20px;
    object-fit: cover;
  }
  .quote__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .quote__mark {
    height: 40px;
    font-size: 80px;
    font-weight: 700;
    line-height: 1;
    color: var(--c-blue);
  }
  .quote__text {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--c-text);
  }
  .quote__by {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.4;
    color: rgb(89, 100, 107);
  }
  .quote__by strong { font-size: 16px; color: var(--c-blue); }

  /* ---------- More Services ---------- */
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 1200px;
  }
  .pill {
    display: flex;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
    align-items: center;
    gap: 10px;
    padding: 19px; /* 20px in Framer, whose 1px border is drawn inside the box */
    border: 1px solid rgb(238, 238, 238);
    border-radius: 20px;
    background: var(--c-white);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
    color: var(--c-black);
    white-space: nowrap;
  }
  .pill :global(.pill__icon) { flex: none; width: 20px; height: 20px; color: var(--c-blue); }
  .pill:hover { border-color: var(--c-blue); color: var(--c-blue); }

  /* ---------- Tablet ---------- */
  @media (max-width: 1199.98px) {
    .intro { gap: 20px; }
  }

  /* ---------- Phone ---------- */
  @media (max-width: 809.98px) {
    .services { gap: 30px; }
    .intro {
      flex-direction: column;
      gap: 20px;
    }
    .intro__heading,
    .intro__lead { flex: none; width: 100%; }
    .group__logos {
      display: grid;
      grid-template-columns: repeat(2, minmax(50px, 1fr));
      grid-auto-rows: minmax(0, 1fr); /* equal rows, as in Framer */
      width: 351px;
      max-width: 100%;
    }
    .group__item { place-self: start; width: 100%; }
    .group__item img { height: auto; aspect-ratio: 2.05479; }
    .bento { flex-direction: column; }
    .bento__col { flex: none; width: 100%; height: auto; }
    .quote {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 24px;
    }
    .quote__photo { width: 96px; height: 96px; border-radius: 16px; }
    .quote__text { font-size: 18px; }
  }
</style>
