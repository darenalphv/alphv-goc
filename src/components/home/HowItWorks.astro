---
/**
 * Home — "How It Works - AI Consulting".
 * Centered heading + an auto-fill grid of step cards (min 250px columns:
 * 4 across at desktop, 3 at tablet, 1 on phone). No appear effects on the live site.
 *
 * Note: the following "Awards-Section" frame is hidden at every breakpoint in Framer, so it is not ported.
 */
const steps = [
  {
    number: '01',
    title: 'Discover',
    body: 'Map workflows, data sources, teams, and decisions to uncover where AI can create measurable operational value.',
  },
  {
    number: '02',
    title: 'Design',
    body: 'Define the AI roadmap, integration plan, governance model, and success metrics before anything is built.',
  },
  {
    number: '03',
    title: 'Implement',
    body: 'Build assistants, automations, analytics, and integrations that fit your existing tools instead of disrupting them.',
  },
  {
    number: '04',
    title: 'Improve',
    body: 'Monitor adoption, tune outputs, train users, and scale the system as new use cases become clear.',
  },
];
---

<section class="hiw" aria-labelledby="hiw-title">
  <div class="hiw__heading">
    <p class="hiw__eyebrow">How It Works</p>
    <h2 id="hiw-title" class="hiw__title">From AI strategy to working systems</h2>
    <p class="hiw__desc">
      We identify high-value AI opportunities, design the right architecture, then implement and improve the solution
      with your team until it becomes part of daily operations.
    </p>
  </div>

  <ol class="hiw__grid">
    {
      steps.map((step, i) => (
        <li class="hiw__step">
          <span class:list={['hiw__number', { 'hiw__number--active': i === 0 }]}>{step.number}</span>
          <div class="hiw__copy">
            <h3 class="hiw__step-title">{step.title}</h3>
            <p class="hiw__step-body">{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .hiw {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    width: 90%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 100px 0;
    overflow: clip;
  }

  .hiw__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 840px;
    text-align: center;
  }
  .hiw__eyebrow {
    width: 100%;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-blue);
  }
  .hiw__title {
    width: 100%;
    font-size: 45px;
    font-weight: 600;
    line-height: 1.18;
    color: var(--c-text);
    text-wrap: balance;
  }
  .hiw__desc {
    width: 100%;
    max-width: 720px;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.5;
    color: rgba(109, 122, 130, 0.7);
    text-wrap: balance;
  }

  .hiw__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-auto-rows: minmax(0, 1fr);
    justify-content: center;
    gap: 20px;
    width: 100%;
  }
  .hiw__step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: start;
    gap: 28px;
    min-height: 260px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--c-white);
    box-shadow: inset 0 0 0 1px var(--c-border), 0 3px 10px rgba(0, 0, 0, 0.03);
  }

  .hiw__number {
    padding: 8px 12px;
    border-radius: 100px;
    background: rgba(29, 100, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(29, 100, 255, 0.14);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--c-blue);
  }
  .hiw__number--active {
    background: var(--c-blue);
    box-shadow: none;
    color: var(--c-white);
  }

  .hiw__copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }
  .hiw__step-title {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--c-text);
  }
  .hiw__step-body {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(109, 122, 130, 0.7);
  }
</style>
