// "colour" is the full-colour lockup (blue mark, black type) for white backgrounds only;
// "white" is the one-colour lockup for black, blue and photography.
interface Props {
  variant?: 'colour' | 'white';
  class?: string;
}
const { variant = 'colour', class: className } = Astro.props;
const text = ["M 50.137 33.162 L 57.862 17.836 L 61.134 17.836 L 68.859 33.162 L 65.698 33.162 L 64.05 29.861 L 54.745 29.861 L 53.098 33.162 Z M 55.903 27.496 L 62.893 27.496 L 60.868 23.325 C 60.793 23.162 60.685 22.927 60.545 22.623 C 60.404 22.318 60.263 22.001 60.122 21.675 C 59.981 21.348 59.851 21.058 59.732 20.805 C 59.613 20.552 59.532 20.396 59.488 20.336 L 59.31 20.336 C 59.176 20.634 59.02 20.98 58.842 21.373 C 58.665 21.767 58.494 22.143 58.331 22.5 C 58.167 22.857 58.033 23.14 57.93 23.348 L 55.904 27.497 Z",
