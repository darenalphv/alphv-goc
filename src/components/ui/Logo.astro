  "M 106.214 33.163 L 106.214 17.837 L 109.085 17.837 L 109.085 24.083 L 120.016 24.083 L 120.016 17.837 L 122.887 17.837 L 122.887 33.163 L 120.016 33.163 L 120.016 26.626 L 109.085 26.626 L 109.085 33.163 Z",
  "M 132.927 33.163 L 125.581 17.837 L 128.809 17.837 L 133.105 27.072 C 133.268 27.4 133.44 27.767 133.617 28.176 C 133.795 28.585 133.974 28.987 134.151 29.381 C 134.329 29.775 134.478 30.114 134.597 30.396 L 134.775 30.396 C 134.893 30.129 135.035 29.801 135.198 29.414 C 135.361 29.027 135.535 28.63 135.721 28.221 C 135.907 27.812 136.081 27.436 136.244 27.094 L 140.562 17.836 L 143.613 17.836 L 136.289 33.162 L 132.927 33.162 Z"];
const mark = ["M 25.808 13.962 C 24.497 10.943 22.648 8.102 20.259 5.588 L 0.388 25.5 L 20.258 45.412 C 22.648 42.898 24.496 40.056 25.807 37.038 L 14.293 25.5 L 25.807 13.962 Z",
  "M 34.165 5.587 L 25.808 13.962 C 28.996 21.302 28.996 29.697 25.808 37.038 L 34.165 45.412 C 44.753 34.268 44.753 16.731 34.165 5.586 Z"];
---

<svg
  class:list={['logo', `logo--${variant}`, className]}
  viewBox="0 0 144 51"
  role="img"
  aria-label="ALPHV"
  focusable="false"
>
  <g class="logo__type">{text.map((d) => <path d={d} />)}</g>
  <g class="logo__mark">{mark.map((d) => <path d={d} />)}</g>
</svg>

<style>
  .logo {
    height: 36px;
    width: auto;
  }
  .logo--colour .logo__type {
    fill: var(--black);
  }
  .logo--colour .logo__mark {
    fill: var(--blue);
  }
  .logo--white .logo__type,
  .logo--white .logo__mark {
    fill: var(--white);
  }
</style>
