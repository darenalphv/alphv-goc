---
// Contact page — contact cards (KL head office, Singapore registered office, group lines, Recruit, WhatsApp) and a "go direct" grid
// linking to each company's own site. Uses the same rounded-card and tag styling as the home page.
import { url } from '../../lib/paths';
import { links } from '../../lib/links';

const whatsapp = 'https://wa.me/60165187740';

const cards = [
  {
    label: 'Kuala Lumpur HQ',
    title: 'Bangsar South, Kuala Lumpur',
    lines: ['Unit 21-05, Level 21, Tower A', 'The Vertical Business Suites', '8 Jalan Kerinchi, 59200 Kuala Lumpur'],
    link: { text: 'Open in Google Maps', href: 'https://maps.google.com/?q=The+Vertical+Business+Suites+Bangsar+South' },
  },
  {
    label: 'Singapore',
    title: 'ALPHV Group Pte. Ltd.',
    lines: ['Registered office', '21 Bukit Batok Crescent, #25-73', 'WCEGA Tower, Singapore 658065'],
    link: { text: 'Open in Google Maps', href: 'https://maps.google.com/?q=WCEGA+Tower+21+Bukit+Batok+Crescent+Singapore+658065' },
  },
  {
    label: 'Group',
    title: 'Technologies, Academy & DevRel',
    lines: ['hello@alphv.com', 'Projects, training programs and developer partnerships.'],
    link: { text: 'Email the team', href: 'mailto:hello@alphv.com' },
  },
  {
    label: 'Recruit',
    title: 'Hiring & job seekers',
    lines: ['Companies hiring tech talent, and candidates looking for their next role.'],
    link: { text: 'Hire through ALPHV Recruit', href: links.recruit.hire },
  },
  {
    label: 'WhatsApp',
    title: 'Fastest reply',
    lines: ['Message the group on WhatsApp and we will route you to the right company.'],
    link: { text: 'Start a chat', href: whatsapp },
  },
];

const companies = [
  { name: 'ALPHV Technologies', role: 'AI systems integration & software', href: links.tech.services, logo: '/images/hwb44JkUHK1ej38Ap2SZO0X0sc.png' },
  { name: 'ALPHV Academy', role: 'HRDC-certified training', href: links.academy.courses, logo: '/images/sEHPe4LvaMSZJQ4Q7pHnDhayo.png' },
  { name: 'ALPHV DevRel', role: 'Developer relations & Developer Kaki', href: links.devrel.services, logo: '/images/yaTuWTNK4kISTNQoWMKPCnEnYmQ.png' },
  { name: 'ALPHV Recruit', role: 'Tech recruitment & executive search', href: links.recruit.services, logo: '/images/hWMaJ653nab1sdeWJnht0n5LnI0.png' },
];

---

<section class="details" aria-label="Contact details">
  <ul class="details__cards">
    {
      cards.map((c, i) => (
        <li class="card" data-reveal style={`--reveal-distance: 30px; --reveal-delay: ${i * 80}ms`}>
          <p class="card__label">{c.label}</p>
          <h2 class="card__title">{c.title}</h2>
          <div class="card__lines">
            {c.lines.map((l) => (
              <p>{l}</p>
            ))}
          </div>
          <a
            class="card__link"
            href={c.link.href}
            {...(c.link.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {c.link.text} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="direct">
    <div class="direct__head">
      <p class="direct__eyebrow">Go direct</p>
      <h2 class="direct__title">Which <span class="text-blue">company</span> do you need?</h2>
    </div>
    <ul class="direct__grid">
      {
        companies.map((c, i) => (
          <li data-reveal style={`--reveal-distance: 30px; --reveal-delay: ${i * 80}ms`}>
            <a class="company" href={c.href} target="_blank" rel="noopener">
              <img src={url(c.logo)} alt="" width="290" height="138" loading="lazy" decoding="async" />
              <span class="company__name">{c.name}</span>
              <span class="company__role">{c.role}</span>
              <span class="company__go" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 100px;
    width: 90%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 20px 0 120px;
  }

  .details__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--c-border);
    border-radius: 20px;
    background: var(--c-white);
  }
  .card__label {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: rgba(29, 100, 255, 0.08);
    font-size: 12px;
    font-weight: 600;
    color: var(--c-blue);
  }
  .card__title {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--c-text);
  }
  .card__lines {
    flex: 1;
    font-size: 14px;
    line-height: 1.7;
    color: rgb(89, 100, 107);
  }
  .card__link {
    margin-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-blue);
    text-decoration: none;
  }
  .card__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .direct {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }
  .direct__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .direct__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-blue);
  }
  .direct__title {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--c-text);
  }
  .direct__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
  }
  .company {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--c-border);
    border-radius: 20px;
    background: var(--c-white);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .company:hover {
    border-color: var(--c-blue);
  }
  .company img {
    width: 140px;
    height: 66px;
    margin-bottom: 8px;
    object-fit: contain;
    object-position: left center;
  }
  .company__name {
    font-size: 17px;
    font-weight: 600;
    color: var(--c-text);
  }
  .company__role {
    font-size: 14px;
    line-height: 1.5;
    color: rgb(89, 100, 107);
  }
  .company__go {
    position: absolute;
    top: 20px;
    right: 22px;
    font-size: 18px;
    color: var(--c-blue);
  }

  @media (max-width: 1199.98px) {
    .direct__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 809.98px) {
    .details {
      gap: 60px;
      padding-bottom: 80px;
    }
    .details__cards,
    .direct__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .direct__title {
      font-size: 30px;
    }
  }
</style>
