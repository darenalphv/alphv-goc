---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { url } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  /** Root-relative path of this page, used for the canonical URL, e.g. "/about-us". */
  path: string;
  ogImage?: string;
  /** Set false for pages that should not be indexed (e.g. 404). */
  index?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/images/XLdIyFNeWEQPk8DuOEnZbpdQjhk.png',
  index = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://alphvgroup.com');
const canonical = new URL(url(path), site).href;
const ogImageUrl = new URL(url(ogImage), site).href;
const GA_ID = 'G-5QRFPXJGLL';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!index && <meta name="robots" content="noindex" />}
    {index && <meta name="robots" content="max-image-preview:large" />}

    <link rel="icon" href={url('/images/jq4WovQ1ikJKT8oEG9yJscS3Sw.png')} />
    <link rel="apple-touch-icon" href={url('/images/sbU8quCzhgRkhiu6zpt0c4AtA.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Brand typefaces: Archivo Expanded (width 125) for display, Inter for body. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,500&family=Inter:wght@400;500&display=swap"
    />

    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
