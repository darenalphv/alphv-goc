---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/about/Hero.astro';
import Story from '../components/about/Story.astro';
import VisionMission from '../components/about/VisionMission.astro';
import Impact from '../components/about/Impact.astro';
import Ecosystem from '../components/about/Ecosystem.astro';
import GroupStructure from '../components/about/GroupStructure.astro';
import Founder from '../components/about/Founder.astro';
import CtaInnovate from '../components/shared/CtaInnovate.astro';
---

<BaseLayout
  title="About the ALPHV Group of Companies"
  description="Meet the ALPHV group: ALPHV Group Pte. Ltd. in Singapore and its Malaysian companies spanning AI engineering, training, developer relations and tech recruitment, behind Developer Kaki."
  path="/about-us"
>
  <Hero />
  <Story />
  <VisionMission />
  <Impact />
  <Ecosystem />
  <GroupStructure />
  <Founder />
  <CtaInnovate />
</BaseLayout>

<style>
  /* About sections slide up 170px into place without fading (Framer appear: y 170 → 0, opacity 1). */
  :global(html.js .about-slide[data-reveal]) {
    opacity: 1;
    transition-duration: 1s;
  }
</style>
