---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { companies, contact } from '../data/group';
---

<BaseLayout
  title="Contact the ALPHV Group of Companies"
  description="Talk to ALPHV about AI integration, custom software, HRDC-certified training, developer programs or tech hiring. Message us on WhatsApp or email hello@alphv.com."
  path="/contact-us"
>
  <PageHero
    kicker="Contact"
    title="Talk to<br />the group."
    lead="Tell ALPHV what you need. Messages are routed to the right company, whether that is a system build, a training program, a developer campaign or a hire."
  >
    <div class="actions">
      <a class="btn btn--primary" href={`mailto:${contact.email}`}><Icon name="mail" /> {contact.email}</a>
      <a class="btn" href={contact.whatsapp} target="_blank" rel="noopener"><Icon name="message" /> WhatsApp</a>
    </div>
  </PageHero>

  <section class="section" aria-label="Contact details">
    <div class="wrap details">
      <div class="detail">
        <p class="label accent">Headquarters</p>
        <address class="lead">{contact.address.map((l) => <span>{l}</span>)}</address>
        <p class="body muted">Regional presence in Singapore.</p>
      </div>
      <div class="detail">
        <p class="label accent">Group</p>
        <a class="lead detail__link" href={contact.phoneHref}>{contact.phone}</a>
        <a class="lead detail__link" href={`mailto:${contact.email}`}>{contact.email}</a>
        <p class="body muted">Technologies, Academy and DevRel.</p>
      </div>
      <div class="detail">
        <p class="label accent">Recruit</p>
        <a class="lead detail__link" href={contact.recruitPhoneHref}>{contact.recruitPhone}</a>
        <a class="lead detail__link" href={`mailto:${contact.email}`}>{contact.email}</a>
        <p class="body muted">Hiring and job seekers.</p>
      </div>
    </div>
  </section>

  <section class="section section--muted" aria-labelledby="route-title">
    <div class="wrap">
      <div class="head">
        <div class="head__title">
          <p class="label accent">Go direct</p>
          <h2 class="h1" id="route-title">Which company<br />do you need?</h2>
        </div>
      </div>
      <ul class="route">
        {
          companies.map((c) => (
            <li>
              <a class="route__row" href={c.url} target="_blank" rel="noopener">
                <span class="label">{c.verb}</span>
                <span class="h3">{c.name}</span>
                <span class="muted route__text">{c.category}</span>
                <Icon name="arrow-up-right" size={20} class="route__icon" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .detail {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 24px;
  }
  .detail + .detail {
    padding-left: 24px;
    border-left: var(--hairline);
  }
  .detail address {
    display: flex;
    flex-direction: column;
    font-style: normal;
  }
  .detail__link {
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease);
  }
  .detail__link:hover {
    color: var(--blue);
  }
  .route {
    border-top: var(--rule);
    background: var(--white);
  }
  .route__row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) minmax(0, 1fr) 20px;
    align-items: center;
    gap: 16px;
    padding: 28px 24px;
    border-bottom: var(--hairline);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .route__row:hover {
    background: var(--blue);
    color: var(--white);
  }
  .route__row:hover .muted {
    color: var(--white);
  }
  @media (max-width: 960px) {
    .details {
      grid-template-columns: 1fr;
    }
    .detail,
    .detail + .detail {
      padding: 24px 0;
      border-left: 0;
      border-bottom: var(--hairline);
    }
  }
  @media (max-width: 640px) {
    .route__row {
      grid-template-columns: minmax(0, 1fr) 20px;
      padding: 20px 16px;
    }
    .route__text {
      display: none;
    }
    .route__row :global(.route__icon) {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }
</style>
