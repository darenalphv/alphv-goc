---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import CompanyGrid from '../components/sections/CompanyGrid.astro';
import Ecosystem from '../components/sections/Ecosystem.astro';
import WorkTable from '../components/sections/WorkTable.astro';
import Clients from '../components/sections/Clients.astro';
import Press from '../components/sections/Press.astro';
import Careers from '../components/sections/Careers.astro';
import Faq from '../components/sections/Faq.astro';
import ContactBand from '../components/sections/ContactBand.astro';
---

<BaseLayout
  title="ALPHV — Technology, Training, Developer Community & Talent Group"
  description="ALPHV is a Malaysian group of companies: ALPHV Technologies (AI & software), Academy (HRDC-certified training), DevRel (75,000+ developer community) and Recruit (tech recruitment)."
  path="/"
>
  <HomeHero />
  <CompanyGrid />
  <Ecosystem />
  <WorkTable />
  <Clients />
  <Press />
  <Careers />
  <Faq />
  <ContactBand />
</BaseLayout>
