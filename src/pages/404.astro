---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';

const arrow =
  'M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z';
---

<BaseLayout title="Page not found — ALPHV" description="The page you are looking for does not exist." path="/404" index={false}>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="tag"><span class="tag__dot" aria-hidden="true"></span>Error 404</p>
    <h1 class="not-found__title" id="not-found-title">
      This page took a <span class="text-blue">wrong turn</span>
    </h1>
    <p class="not-found__lead">
      The page you’re looking for doesn’t exist or has moved. Let’s get you back to building what’s next.
    </p>
    <a class="btn btn--primary" href={url('/')}>
      <span>Back to Home</span>
      <span class="btn__icon" aria-hidden="true">
        <svg viewBox="0 0 256 256" fill="currentColor" focusable="false"><path d={arrow} /></svg>
      </span>
    </a>
    <p class="not-found__code" aria-hidden="true">404</p>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 80px 20px 140px;
    overflow: hidden;
    text-align: center;
  }
  .not-found > :not(.not-found__code) {
    position: relative;
    z-index: 1;
  }
  .not-found__title {
    max-width: 720px;
    font-size: 52px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--c-text);
    text-wrap: balance;
  }
  .not-found__lead {
    max-width: 520px;
    margin-bottom: 10px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.8;
    color: var(--c-text-body);
    text-wrap: pretty;
  }
  /* Oversized outline numerals behind the content, in the spirit of the footer's #SEEKALPHV */
  .not-found__code {
    position: absolute;
    left: 50%;
    bottom: -0.26em;
    transform: translateX(-50%);
    font-size: clamp(180px, 34vw, 420px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(29, 100, 255, 0.14);
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 809.98px) {
    .not-found {
      padding: 60px 20px 110px;
    }
    .not-found__title {
      font-size: 36px;
    }
  }
</style>
