---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { url } from '../lib/paths';
---

<BaseLayout title="Page not found — ALPHV" description="The page you are looking for does not exist." path="/404" index={false}>
  <PageHero kicker="Error 404" title="Page not<br />found." lead="This page does not exist or has moved.">
    <a class="btn btn--primary" href={url('/')}>Back to home <Icon name="arrow-right" /></a>
  </PageHero>
  <div style="padding-bottom: var(--section)"></div>
</BaseLayout>
