---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Ecosystem from '../components/sections/Ecosystem.astro';
import ContactBand from '../components/sections/ContactBand.astro';
import Icon from '../components/ui/Icon.astro';
import { url } from '../lib/paths';
import { companies } from '../data/group';
---

<BaseLayout
  title="Our Companies — Technologies, Academy, DevRel & Recruit | ALPHV"
  description="Explore the ALPHV group: AI systems integration, HRDC-certified training, developer relations and tech recruitment across Malaysia and Southeast Asia."
  path="/service"
>
  <PageHero
    kicker="Our companies"
    title="Four<br />companies."
    lead="ALPHV Technologies, ALPHV Academy, ALPHV DevRel and ALPHV Recruit. Each runs its own team and website. Together they build, train, grow and hire."
  >
    <nav class="jump" aria-label="Companies on this page">
      {companies.map((c, i) => <a class="link" href={`#${c.id}`}>0{i + 1} {c.short}</a>)}
    </nav>
  </PageHero>

  {
    companies.map((c, i) => (
      <section class="co section" id={c.id} aria-labelledby={`${c.id}-title`}>
        <div class="wrap co__grid">
          <div class="co__intro">
            <p class="label accent">
              0{i + 1} _ {c.category}
            </p>
            <h2 class="h2" id={`${c.id}-title`}>
              ALPHV<br />{c.short}
            </h2>
            <p class="lead">{c.summary}</p>
            <p class="body muted">{c.detail}</p>
            <div class="actions">
              <a class="btn btn--primary" href={c.url} target="_blank" rel="noopener">
                Visit {c.domain} <Icon name="arrow-up-right" />
              </a>
            </div>
          </div>

          <div class="co__side">
            {c.image && (
              <img class="co__img" src={url(c.image.src)} alt={c.image.alt} loading="lazy" decoding="async" />
            )}
            <dl class="stats stats--stack" style="--cols: 3">
              {c.facts.map((f) => (
                <div>
                  <dt class="label muted">{f.label}</dt>
                  <dd class="h3">{f.value}</dd>
                </div>
              ))}
            </dl>
            <div>
              <p class="label co__services-title">Services</p>
              <ul class="co__services">
                {c.services.map((s) => (
                  <li>
                    <span class="co__service">{s.title}</span>
                    <span class="muted">{s.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <Ecosystem />
  <div style="padding-top: var(--section)"></div>
  <ContactBand />
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .co + .co .co__grid {
    padding-top: var(--section);
    border-top: var(--rule);
  }
  .co + .co {
    padding-top: 0;
  }
  .co__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
  }
  .co__intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-self: start;
    position: sticky;
    top: 112px;
  }
  .co__side {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .co__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: grayscale(1);
  }
  .co__services-title {
    padding-bottom: 12px;
    border-bottom: var(--rule);
  }
  .co__services li {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 16px;
    padding-block: 16px;
    border-bottom: var(--hairline);
    font-size: 15px;
  }
  .co__service {
    font-weight: 500;
  }
  @media (max-width: 960px) {
    .co__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .co__intro {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .co__services li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
